// The site as a Cloudflare Worker with static assets: the primary deploy. Workers Builds runs
// `npm run build`, then `npx wrangler deploy`, on every push to main.
//
// The Cloudflare Pages project of the same name still builds every push from functions/ and
// public/ (it ignores this file, which has no pages_build_output_dir) and stays live at
// ahmed-portfolio-a76.pages.dev as the standby. docs/hosting.md says how to switch between them.
{
  "name": "ahmed-portfolio",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /fr is served from fr.html, and /fr.html and /fr/ redirect to /fr, as on Pages.
    "html_handling": "drop-trailing-slash",
    // An unknown path gets dist/404.html with a 404 status, as on Pages.
    "not_found_handling": "404-page",
    // Only the contact form needs code; every other request is a file, served without it.
    "run_worker_first": ["/api/*"]
  },
  // The site is served on ahmedchioua.com only; a workers.dev copy would be a duplicate.
  "workers_dev": false,
  "vars": {
    // RESEND_API_KEY is a secret, set on the Worker in the dashboard, never in this file.
    "CONTACT_FROM": "Ahmed Chioua Portfolio <contact@ahmedchioua.com>"
  },
  "observability": { "enabled": true }
}
